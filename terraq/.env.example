# TerraQ dashboard / Explorer console — environment variables.
# Copy to .env.local and fill in. The app works with ALL of these empty:
# basemaps, geology, search and the engine need no keys, and target
# explanations fall back to a deterministic template when no LLM key is set.

# ---- Engine ---------------------------------------------------------------
# Where the Python engine (product/server.py) listens.
# Defaults to http://localhost:8765; start.sh sets this when it picks a
# fallback port. This is the ONLY variable exposed to the browser.
NEXT_PUBLIC_ENGINE_URL=

# ---- LLM (optional) -------------------------------------------------------
# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Provider chain: GROQ_MODEL -> GROQ_FALLBACK_MODEL -> Gemini -> template.
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# Optional backup provider, used only if set.
GEMINI_API_KEY=
